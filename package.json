{
  "name": "puff-lounge",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node node_modules/expo/bin/cli start",
    "android": "node node_modules/expo/bin/cli start --android",
    "ios": "node node_modules/expo/bin/cli start --ios",
    "web": "node node_modules/expo/bin/cli start --web",
    "preexport:web": "node -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});if(fs.existsSync('node_modules/leaflet/dist/leaflet.css'))fs.copyFileSync('node_modules/leaflet/dist/leaflet.css','public/leaflet.css');if(fs.existsSync('assets/icon.png')){for(const f of ['apple-touch-icon.png','icon-192.png','icon-512.png']){if(!fs.existsSync('public/'+f))fs.copyFileSync('assets/icon.png','public/'+f);}}\"",
    "export:web": "node node_modules/expo/bin/cli export --platform web",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "eas": "node node_modules/eas-cli/bin/run",
    "build:apk": "node node_modules/eas-cli/bin/run build -p android --profile preview"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.21",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "fuse.js": "^7.5.0",
    "leaflet": "^1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "~19.3.0",
    "eas-cli": "^27.2.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
